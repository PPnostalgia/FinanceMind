---
interface Props {
  title?: string;
  description?: string;
}

const { title = 'Finance & Mind', description = '用《经济学人》构建认知图谱 · 每周一篇，终身成长' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title === 'Finance & Mind' ? title : `${title} — Finance & Mind`}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body class="min-h-screen flex flex-col bg-paper text-ink font-body" style="font-feature-settings:'kern' 1,'liga' 1">
  <!-- Header -->
  <header class="border-b border-border bg-paper/95 backdrop-blur-sm sticky top-0 z-10">
    <div class="max-w-5xl mx-auto px-5 h-14 flex items-center justify-between">
      <a href={`${base}/`} class="font-header font-bold text-[1.05rem] text-ink hover:text-primary transition-colors no-underline">
        Finance &amp; Mind
      </a>
      <nav class="flex items-center gap-6 text-sm font-medium text-ink-mid">
        <a href={`${base}/wechat/`} class="hover:text-primary transition-colors no-underline">精读</a>
        <a href={`${base}/kb/`} class="hover:text-primary transition-colors no-underline">知识库</a>
      </nav>
    </div>
  </header>

  <!-- Main -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-border mt-16 py-8">
    <div class="max-w-5xl mx-auto px-5 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
      <p class="text-sm text-muted">Finance &amp; Mind · 每周精读《经济学人》</p>
      <p class="text-xs text-muted">用英语学习构建认知图谱</p>
    </div>
  </footer>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
