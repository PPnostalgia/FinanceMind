---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allWechat = await getCollection('wechat', e => e.data.publish);
const latestArticles = allWechat
  .filter(e => e.data.article_type !== 'curated')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
const latestCurated = allWechat
  .filter(e => e.data.article_type === 'curated')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const allKb = await getCollection('kb', e => e.data.publish);

const disciplineConfig = [
  { key: 'economics',      icon: '💰', title: '行为金融', desc: '宏观经济 · 市场机制 · 金融理论' },
  { key: 'mental-models',  icon: '🧠', title: '思维模型', desc: '决策框架 · 芒格体系 · 认知工具' },
  { key: 'science-tech',   icon: '💻', title: '科技前沿', desc: '科技趋势 · AI · 产品与职业'    },
  { key: 'psychology',     icon: '🎯', title: '心理学',   desc: '认知偏误 · 行为研究 · 心理效应' },
];

const disciplineLabels: Record<string, string> = {
  economics:       '行为金融',
  'mental-models': '思维模型',
  'science-tech':  '科技前沿',
  psychology:      '心理学',
};
---

<BaseLayout>
  <!-- Hero -->
  <section class="border-b border-border bg-gradient-to-b from-paper to-white">
    <div class="max-w-5xl mx-auto px-5 py-16 md:py-20">
      <p class="text-xs font-semibold tracking-widest uppercase text-secondary mb-4">Finance &amp; Mind</p>
      <h1 class="font-header text-[2rem] md:text-[2.6rem] font-bold text-ink leading-tight mb-4">
        Finance &amp; Mind
      </h1>
      <p class="text-base text-muted max-w-xl leading-relaxed border-l-[3px] border-secondary pl-4 italic font-header">
        从经济学人精读到精选长文，沉淀金融、科技与心理学的英文知识库。
      </p>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-5 py-12">
    <!-- Knowledge Base -->
    <section class="mb-16">
      <div class="flex items-baseline justify-between mb-6">
        <h2 class="font-header text-[1.15rem] font-bold text-ink">知识库</h2>
        <a href={`${base}/kb/`} class="text-sm text-primary hover:text-secondary transition-colors no-underline font-medium">
          全部 →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {disciplineConfig.map(d => {
          const count = allKb.filter(e => e.data.discipline === d.key || e.id.startsWith(d.key + '/')).length;
          return (
            <a
              href={`${base}/kb/${d.key}/`}
              class="group flex items-center gap-4 p-4 rounded-xl border border-border bg-white/50 hover:border-primary/40 hover:shadow-[0_4px_18px_rgba(0,0,0,0.07)] hover:-translate-y-0.5 transition-all no-underline"
            >
              <span class="text-[1.8rem] leading-none">{d.icon}</span>
              <div class="flex-1 min-w-0">
                <p class="text-[0.92rem] font-semibold text-ink group-hover:text-primary transition-colors mb-0.5 font-header">
                  {d.title}
                </p>
                <p class="text-[0.75rem] text-muted leading-relaxed">{d.desc}</p>
              </div>
              <div class="shrink-0 text-right">
                {count > 0 && <span class="text-xs text-muted">{count} 条</span>}
                <span class="text-muted group-hover:text-primary transition-colors text-sm block">→</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Latest Articles -->
    <section class="mb-16">
      <div class="flex items-baseline justify-between mb-6">
        <h2 class="font-header text-[1.15rem] font-bold text-ink">最新精读</h2>
        <a href={`${base}/wechat/`} class="text-sm text-primary hover:text-secondary transition-colors no-underline font-medium">
          全部 →
        </a>
      </div>

      {latestArticles.length === 0 ? (
        <p class="text-sm text-muted py-8 text-center">暂无文章，运行 npm run sync-content 同步内容后重试。</p>
      ) : (
        <div class="divide-y divide-border">
          {latestArticles.map(article => (
            <a
              href={`${base}/wechat/${article.slug}/`}
              class="group flex items-start justify-between gap-4 py-4 hover:bg-white/60 -mx-3 px-3 rounded-lg transition-colors no-underline"
            >
              <div class="flex-1 min-w-0">
                <p class="text-[0.95rem] font-medium text-ink group-hover:text-primary transition-colors leading-snug mb-1 font-header">
                  {article.data.title}
                </p>
                <div class="flex items-center gap-3 text-xs text-muted">
                  {article.data.discipline && (
                    <span>{disciplineLabels[article.data.discipline] ?? article.data.discipline}</span>
                  )}
                  {article.data.source_article && (
                    <span class="italic truncate max-w-[200px]">{article.data.source_article}</span>
                  )}
                </div>
              </div>
              <div class="shrink-0 text-right">
                <span class="text-xs text-muted font-mono">
                  {article.data.date.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' }).replace('/', '-')}
                </span>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>

    <!-- Curated Articles -->
    <section>
      <div class="flex items-baseline justify-between mb-6">
        <h2 class="font-header text-[1.15rem] font-bold text-ink">精选文章</h2>
        <a href={`${base}/curated/`} class="text-sm text-primary hover:text-secondary transition-colors no-underline font-medium">
          全部 →
        </a>
      </div>

      {latestCurated.length === 0 ? (
        <p class="text-sm text-muted py-8 text-center">暂无精选文章。</p>
      ) : (
        <div class="divide-y divide-border">
          {latestCurated.map(article => (
            <a
              href={`${base}/curated/${article.slug}/`}
              class="group flex items-start justify-between gap-4 py-4 hover:bg-white/60 -mx-3 px-3 rounded-lg transition-colors no-underline"
            >
              <div class="flex-1 min-w-0">
                <p class="text-[0.95rem] font-medium text-ink group-hover:text-primary transition-colors leading-snug mb-1 font-header">
                  {article.data.title}
                </p>
                <div class="flex items-center gap-3 text-xs text-muted">
                  {article.data.discipline && (
                    <span>{disciplineLabels[article.data.discipline] ?? article.data.discipline}</span>
                  )}
                  {article.data.source_article && (
                    <span class="italic truncate max-w-[200px]">{article.data.source_article}</span>
                  )}
                </div>
              </div>
              <div class="shrink-0 text-right">
                <span class="text-xs text-muted font-mono">
                  {article.data.date.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' }).replace('/', '-')}
                </span>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>
  </div>
</BaseLayout>
