---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const articles = (await getCollection('wechat', e => e.data.publish))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const disciplineLabels: Record<string, string> = {
  economics:       '行为金融',
  'mental-models': '思维模型',
  'science-tech':  '科技前沿',
  psychology:      '心理学',
};
---

<BaseLayout title="精读文章" description="每周精读《经济学人》，兼顾英语学习与知识拓展">
  <div class="max-w-3xl mx-auto px-5 py-10">
    <!-- Page header -->
    <header class="mb-10">
      <nav class="text-xs text-muted mb-6 flex items-center gap-2">
        <a href={`${base}/`} class="hover:text-primary transition-colors no-underline">首页</a>
        <span>›</span>
        <span class="text-ink-mid">精读文章</span>
      </nav>
      <h1 class="font-header text-[1.9rem] font-bold text-ink mb-2">精读文章</h1>
      <p class="text-sm text-muted">每期精选原文段落，对照译文 · 生词注释 · 知识延伸</p>
    </header>

    <!-- Article list -->
    {articles.length === 0 ? (
      <p class="text-sm text-muted py-12 text-center">
        暂无文章。运行 <code class="font-mono bg-border/60 px-1 rounded">npm run sync-content</code> 同步内容。
      </p>
    ) : (
      <div class="space-y-0 divide-y divide-border">
        {articles.map(article => (
          <a
            href={`${base}/wechat/${article.slug}/`}
            class="group flex items-start justify-between gap-6 py-5 -mx-3 px-3 rounded-lg hover:bg-white/60 transition-colors no-underline"
          >
            <div class="flex-1 min-w-0">
              <h2 class="font-header text-[1.0rem] font-semibold text-ink group-hover:text-primary transition-colors leading-snug mb-1.5">
                {article.data.title}
              </h2>
              <div class="flex items-center gap-3 flex-wrap">
                {article.data.source_article && (
                  <span class="text-xs text-muted italic">"{article.data.source_article}"</span>
                )}
                {article.data.discipline && (
                  <span class="text-xs font-medium text-secondary">
                    {disciplineLabels[article.data.discipline] ?? article.data.discipline}
                  </span>
                )}
                {article.data.source_issue && (
                  <span class="text-xs font-mono text-muted bg-border/60 px-1.5 py-0.5 rounded">
                    {article.data.source_issue}
                  </span>
                )}
              </div>
              {article.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-1 mt-2">
                  {article.data.tags.map(t => (
                    <span class="tag-pill">#{t}</span>
                  ))}
                </div>
              )}
            </div>
            <div class="shrink-0 text-xs text-muted font-mono pt-0.5">
              {article.data.date.toLocaleDateString('zh-CN', {
                year: 'numeric', month: '2-digit', day: '2-digit'
              }).replace(/\//g, '-')}
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
